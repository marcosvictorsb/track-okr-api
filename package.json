{
  "name": "track-okr-api",
  "version": "1.0.0",
  "description": "api de gestão de okr",
  "main": "index.js",
  "_moduleAliases": {
    "@adapters": "src/adapters",
    "@configs": "src/configs",
    "@domains": "src/domains",
    "@common": "src/common",
    "@infra": "src/infra",
    "@middlewares": "src/middlewares",
    "@protocols": "src/protocols",
    "@tasks": "src/tasks",
    "@shared": "src/shared"
  },
  "scripts": {
    "start": "nodemon --watch src --ext ts --exec ts-node -r module-alias/register src/server.ts",
    "start:prod": "node -r module-alias/register dist/server.js",
    "build": "tsc && tsc-alias",
    "pm2:start": "npm run build && pm2 start deployment/ecosystem.config.json",
    "pm2:start:prod": "npm run build && pm2 start deployment/ecosystem.production.json",
    "pm2:start:demo": "npm run build && pm2 start deployment/ecosystem.demo.json",
    "pm2:stop": "pm2 stop track-okr-api",
    "pm2:restart": "pm2 restart track-okr-api",
    "pm2:reload": "pm2 reload track-okr-api",
    "pm2:delete": "pm2 delete track-okr-api",
    "pm2:logs": "pm2 logs track-okr-api",
    "pm2:status": "pm2 status",
    "lint": "eslint --ext .js,.ts .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "migration": "npx sequelize-cli db:migrate",
    "migration:create": "npx sequelize-cli migration:generate --name",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:create": "npx sequelize-cli seed:generate --name",
    "seed:undo": "npx sequelize-cli db:seed:undo",
    "seed:undo:all": "npx sequelize-cli db:seed:undo:all",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "scaffold": "node scaffold.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcosvictorsb/track-okr-api.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marcosvictorsb/track-okr-api/issues"
  },
  "homepage": "https://github.com/marcosvictorsb/track-okr-api#readme",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "nodemon": "^3.1.10",
    "prom-client": "^15.1.3",
    "resend": "^4.6.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "typescript": "^5.8.3",
    "uuid4": "^2.0.3",
    "winston": "^3.17.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/request": "^2.48.12",
    "@types/uuid4": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
