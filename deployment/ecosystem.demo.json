{
  "apps": [
    {
      "name": "track-okr-demo",
      "script": "dist/server.js",
      "cwd": "/var/www/gunno/testing/track-okr-api",
      "instances": 1,
      "exec_mode": "cluster",
      "watch": false,
      "max_memory_restart": "256M",
      "env_file": ".env",
      "error_file": "/var/www/gunno/testing/logs/api-error.log",
      "out_file": "/var/www/gunno/testing/logs/api-out.log",
      "log_file": "/var/www/gunno/testing/logs/api-combined.log",
      "time": true,
      "autorestart": true,
      "max_restarts": 15,
      "min_uptime": "5s",
      "restart_delay": 2000,
      "kill_timeout": 3000,
      "listen_timeout": 5000
    }
  ]
}
