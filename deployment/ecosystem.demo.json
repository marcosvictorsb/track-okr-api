{
  "apps": [
    {
      "name": "track-okr-demo",
      "script": "dist/server.js",
      "cwd": "/opt/trackokr/demo/api",
      "instances": 1,
      "exec_mode": "cluster",
      "watch": false,
      "max_memory_restart": "256M",
      "env": {
        "NODE_ENV": "demo",
        "PORT": 3002,
        "DB_NAME": "track_okr_demo",
        "DB_USER": "trackokr_demo",
        "REDIS_DB": "1",
        "APP_ENV": "demo",
        "LOG_LEVEL": "debug",
        "ENABLE_DEMO_FEATURES": "true",
        "AUTO_RESET_DEMO_DATA": "true"
      },
      "error_file": "/opt/trackokr/demo/logs/api-error.log",
      "out_file": "/opt/trackokr/demo/logs/api-out.log",
      "log_file": "/opt/trackokr/demo/logs/api-combined.log",
      "time": true,
      "autorestart": true,
      "max_restarts": 15,
      "min_uptime": "5s",
      "restart_delay": 2000,
      "kill_timeout": 3000,
      "listen_timeout": 5000
    }
  ]
}
